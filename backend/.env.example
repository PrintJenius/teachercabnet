# Supabase — Session pooler(5432). db.xxx.supabase.co는 IPv6만 있어 Java에서 UnknownHost 가능
# Transaction(6543)은 prepared statement 오류 → 5432 사용
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=your-database-password
JPA_DDL_AUTO=update

FRONTEND_ORIGIN=http://localhost:5173
RAG_SERVER_BASE_URL=http://localhost:8001
RAG_NAMESPACE=play_data
RAG_TOP_K=5

# JWT (HS256, 최소 32바이트). 운영에서는 반드시 긴 랜덤 값으로 교체.
JWT_SECRET=change-me-use-at-least-32-characters-long!!
JWT_EXPIRATION_MS=86400000

# 관리자 loginId (쉼표 구분, application.yaml의 app.admin.login-ids)
ADMIN_LOGIN_IDS=admin

# DB에 관리자가 없을 때 1회 자동 생성 (비우면 생성 안 함). 실제 값은 .env에만 넣고 커밋 금지.
ADMIN_BOOTSTRAP_LOGIN_ID=your-bootstrap-login-id
ADMIN_BOOTSTRAP_PASSWORD=your-bootstrap-password
ADMIN_BOOTSTRAP_NICKNAME=your-bootstrap-nickname

# 로컬 파일 업로드 (Render: STORAGE_LOCAL_DIR=/tmp/storage, STORAGE_PUBLIC_URL=https://api.example.com)
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_URL=http://localhost:8080
