# Supabase — Session pooler(5432). db.xxx.supabase.co는 IPv6만 있어 Java에서 UnknownHost 가능
# Transaction(6543)은 prepared statement 오류 → 5432 사용
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=your-database-password
JPA_DDL_AUTO=update

MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-app-password
MAIL_FROM=your-email@example.com

FRONTEND_ORIGIN=http://localhost:5173
RAG_SERVER_BASE_URL=http://localhost:8001
RAG_NAMESPACE=play_data
RAG_TOP_K=5

# JWT (HS256, 최소 32바이트). 운영에서는 반드시 긴 랜덤 값으로 교체.
JWT_SECRET=change-me-use-at-least-32-characters-long!!

# 관리자 이메일(쉼표 구분)
ADMIN_EMAILS=admin@example.com
